    "limitation_1_citation_regex_mismatch": {
      "severity": "HIGH (Pipeline Output Truncation)",
      "description": "In generator.py line 171, the citation extraction regex expects [Source: <passage_id>, page X]. When local model gemma:2b prefixes the UUID with 'passage_id=' (e.g. [Source: passage_id=0280358a-..., page 1]), the regex fails to capture the UUID, causing the citation validator to detect zero valid citations. This triggers generator.py line 351's safe abstention guardrail, converting valid SUFFICIENT answers into UNANSWERABLE in production runtime.",
      "affected_queries": [
        "AQ-02",
        "AQ-03",
        "AQ-04",
        "AQ-05",
        "AQ-06",
        "AQ-07"
      ],
      "controller_impact": "None. EvidenceController operates with 100% precision (CECI 0.75 - 0.88). The failure is strictly localized to generator post-processing.",
      "proposed_correction": "Update generator.py regex to r'\\[Source:\\s*(?:passage_id=)?([\\w-]+)(?:,\\s*page\\s*(\\d+))?\\]' in post-M8.6 remediation."
    },
    "limitation_2_small_model_over_abstention": {
      "severity": "MEDIUM",
      "description": "gemma:2b exhibits conservative over-abstention on complex multi-passage prompts, outputting the verbatim UNANSWERABLE template for AQ-02, AQ-05, and AQ-07 despite relevant evidence in its prompt.",
      "proposed_correction": "Enforce structured deterministic answers at the controller level for standard regulatory inquiries (as demonstrated by AQ-01)."
    }
