# IndicRAG-QA Backend Configuration
# Copy this file to .env and fill in values for your environment.
# NEVER commit .env to version control.

# ── Application ────────────────────────────────────────────────────────────────
APP_NAME=IndicRAG-QA
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development

# ── Ollama ─────────────────────────────────────────────────────────────────────
# Ollama must be running: ollama serve
# Available models: run `ollama list`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma:2b
OLLAMA_TIMEOUT=120
GENERATION_TEMPERATURE=0.1
GENERATION_MAX_TOKENS=1024

# ── Embedding ──────────────────────────────────────────────────────────────────
# Multilingual MiniLM — 384-dim, ~120 MB, strong cross-lingual support
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIM=384

# ── Retrieval ──────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=10
RERANK_TOP_K=5
BM25_WEIGHT=0.4
DENSE_WEIGHT=0.6
RRF_K=60
EVIDENCE_MIN_SCORE=0.35
EVIDENCE_SUFFICIENT_COUNT=1
MAX_RETRIEVAL_RETRIES=2

# ── Chunking ───────────────────────────────────────────────────────────────────
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=80
PARENT_CHUNK_SIZE_TOKENS=1200

# ── Upload limits ──────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Evaluation API key ─────────────────────────────────────────────────────────
# Change this before deploying!
EVAL_API_KEY=change-me-in-env
